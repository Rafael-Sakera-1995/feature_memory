# Feature Memory environment variables.
#
# Copy this file to `.env` (in the project root) and fill in the values you
# need. `.env` is gitignored and auto-loaded by the server + migration script
# entrypoints. Anything you set in your shell still takes precedence.
#
# Production deployments (kosmos) do NOT use this file — values are injected
# into the pod by the k8s secret manager. This file is local-dev only.

# --- Storage backend ---------------------------------------------------------
# `local` -> LocalFSStorage on a directory (V1 stdio mode, tests).
# `s3`    -> S3Storage (V2 HTTP mode, prod, plus local smoke tests against
#            either real S3 or LocalStack/moto).
STORAGE_BACKEND=local

# Path to a features/ directory. Required when STORAGE_BACKEND=local.
# Can be relative to where you run `feature-memory-mcp` from.
# FEATURES_DIR=./features

# --- S3 backend (only when STORAGE_BACKEND=s3) ------------------------------
# Bucket name. Matches the Connecteam naming convention (see pymobiengine
# k8s/env line 153 for prod examples like `prod.connecteam.files`).
# S3_BUCKET=prod.connecteam.feature-memory

# Region. Connecteam prod buckets live in eu-central-1 (k8s/env line 146).
# AWS_REGION=eu-central-1

# Optional key prefix inside the bucket — useful to segregate environments
# (e.g. `dev`, `staging`, `prod`) inside a single bucket.
# S3_PREFIX=

# Optional S3-compatible endpoint. Set to http://localhost:4566 for LocalStack
# (full local end-to-end smoke test without touching real AWS). Leave unset
# for real S3. See docs/operations/localstack.md.
# S3_ENDPOINT_URL=http://localhost:4566

# AWS credentials. boto3's default chain reads these (and a few alternatives
# like ~/.aws/credentials or IAM roles), so you can omit them if your shell
# already has them or you're on an EC2/EKS instance with a role attached.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Search (OpenAI) --------------------------------------------------------
# When set, `search_features` works and the migration script writes the
# embeddings cache. When unset, search returns [] and the server falls back
# to `list_features`. Safe to leave blank for local dev that doesn't need
# semantic search.
# OPENAI_API_KEY=
# OPENAI_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# --- Transport --------------------------------------------------------------
# `stdio` for the V1 single-user mode (Cursor MCP plumbing).
# `streamable-http` for the V2 hosted service.
# MCP_TRANSPORT=stdio
# MCP_HOST=0.0.0.0
# MCP_PORT=8080

# --- Auth (HTTP only) -------------------------------------------------------
# When set, the server overrides patch.last_update.author with the value of
# this header on every write. Production: `X-Connecteam-User` (stamped by
# kosmos ingress). Leave unset locally unless you're testing the override.
# AUTH_HEADER=X-Connecteam-User

# --- Cache flush debouncing -------------------------------------------------
# Coalesce cache rewrites within this window. 0 = synchronous (used by tests
# and the V1 stdio path).
# CACHE_DEBOUNCE_SECONDS=60
