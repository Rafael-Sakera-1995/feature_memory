# Env file for the Feature Memory MCP service (eu-west-1, account 983610474571).
# Kosmos renders this and injects the result as real environment variables in
# the pod (the app reads os.environ; it does NOT load a .env file in prod).
#
# Secrets (AWS access key/secret) are NOT in this file - kosmos injects those
# via the platform's secret manager / pod IAM. This file is non-secret config.
#
# NOTE: the bucket + IAM names carry a "memeory" typo that matches what DevOps
# provisioned. Keep it until those resources are renamed, then update here.

# --- Transport --------------------------------------------------------------
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Trusted identity header. Kosmos ingress is responsible for stamping this
# from the SSO-authenticated user so the server can attribute writes server-side.
AUTH_HEADER=X-Connecteam-User

# --- Storage backend (markdown bucket) --------------------------------------
STORAGE_BACKEND=s3
S3_BUCKET=ct-feature-memeory-docs
S3_PREFIX=
AWS_REGION=eu-west-1

# --- S3 Vectors (search backend) --------------------------------------------
S3_VECTOR_BUCKET=ct-feature-memeory
S3_VECTOR_INDEX_NAME=features
# Vector bucket is in the same region as AWS_REGION (eu-west-1).
# S3_VECTOR_REGION=eu-west-1

# --- Bedrock (embeddings) ---------------------------------------------------
# Titan Text Embeddings v2, validated working in eu-west-1.
BEDROCK_REGION=eu-west-1
BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
